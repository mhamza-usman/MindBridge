# Google Gemini API key (free tier: https://aistudio.google.com/apikey).
# The agent uses the native Google Gen AI SDK (langchain-google-genai) on
# gemini-3.5-flash. See FROZEN.md "LLM provider" in the repo root for why.
GEMINI_API_KEY=your-gemini-key

# Optional override. Defaults to gemini-3.5-flash.
# MODEL=gemini-3.5-flash
#
# LOCAL DEV TIP: the free tier gives gemini-3.5-flash only ~20 requests/day.
# Once exhausted it returns HTTP 429, which the UI shows as INCOMPLETE_STREAM.
# If you hit that, switch to a model your key still has quota for — no Google
# Cloud / ADC required:
# MODEL=gemini-2.5-flash

# --- Vertex AI (Google Cloud) instead of the Gemini Developer API ---
# Leave the block below COMMENTED OUT for local development with a plain
# GEMINI_API_KEY. Only enable it for a Google Cloud deployment that has ADC.
# The SAME ChatGoogleGenerativeAI class can target Vertex AI when these are
# set. Auth is Application Default Credentials (run
# `gcloud auth application-default login` or use a service-account key via
# GOOGLE_APPLICATION_CREDENTIALS). gemini-3.5-flash is NOT served on Vertex,
# so set MODEL=gemini-2.5-flash when using Vertex.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# MODEL=gemini-2.5-flash

# LinkUp web search API key (https://app.linkup.so). Used by the
# search_robotics_context tool in the dynamic agent.
LINKUP_API_KEY=your-linkup-api-key
