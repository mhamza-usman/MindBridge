[
  {
    "id": "root",
    "component": "Stack",
    "gap": "md",
    "children": [
      "header",
      "status-row",
      "location-section",
      "sensors-section"
    ]
  },
  {
    "id": "header",
    "component": "Heading",
    "level": "1",
    "text": {
      "path": "/robot_id"
    }
  },
  {
    "id": "status-row",
    "component": "Row",
    "gap": "sm",
    "children": [
      "status-badge",
      "battery-card",
      "task-card"
    ]
  },
  {
    "id": "status-badge",
    "component": "Badge",
    "label": {
      "path": "/status"
    },
    "tone": "positive"
  },
  {
    "id": "task-card",
    "component": "StatCard",
    "label": "Current Task",
    "value": {
      "path": "/current_task"
    }
  },
  {
    "id": "battery-card",
    "component": "StatCard",
    "label": "Battery",
    "value": {
      "path": "/battery_percentage"
    },
    "caption": "%"
  },
  {
    "id": "location-section",
    "component": "Section",
    "title": "Location",
    "child": "location-grid"
  },
  {
    "id": "location-grid",
    "component": "Grid",
    "columns": 3,
    "gap": "sm",
    "children": [
      "loc-x",
      "loc-y",
      "loc-z"
    ]
  },
  {
    "id": "loc-x",
    "component": "StatCard",
    "label": "X",
    "value": {
      "path": "/location/x"
    },
    "caption": "meters"
  },
  {
    "id": "loc-y",
    "component": "StatCard",
    "label": "Y",
    "value": {
      "path": "/location/y"
    },
    "caption": "meters"
  },
  {
    "id": "loc-z",
    "component": "StatCard",
    "label": "Z",
    "value": {
      "path": "/location/z"
    },
    "caption": "meters"
  },
  {
    "id": "sensors-section",
    "component": "Section",
    "title": "Sensors",
    "child": "sensors-grid"
  },
  {
    "id": "sensors-grid",
    "component": "Grid",
    "columns": 3,
    "gap": "sm",
    "children": [
      "sens-temp",
      "sens-lidar",
      "sens-prox"
    ]
  },
  {
    "id": "sens-temp",
    "component": "StatCard",
    "label": "Internal Temp",
    "value": {
      "path": "/sensors/internal_temp_c"
    },
    "caption": "\u00b0C"
  },
  {
    "id": "sens-lidar",
    "component": "StatCard",
    "label": "LiDAR",
    "value": {
      "path": "/sensors/lidar_status"
    }
  },
  {
    "id": "sens-prox",
    "component": "StatCard",
    "label": "Proximity",
    "value": {
      "path": "/sensors/obstacle_proximity_m"
    },
    "caption": "meters"
  }
]